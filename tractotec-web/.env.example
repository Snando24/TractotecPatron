# Supabase (configurar en Vercel → Settings → Environment Variables)
# La anon key es pública por diseño; la seguridad depende de las políticas RLS (ver SUPABASE_SETUP.md).
# NUNCA poner aquí la service_role key.
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu_anon_key_aqui

# Bucket de Supabase Storage para imágenes subidas desde el panel admin
VITE_SUPABASE_BUCKET=project-images
